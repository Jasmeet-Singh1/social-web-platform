
# Copy to .env for local development.
# On Vercel, set these in Project → Settings → Environment Variables.

MONGO_URI=
JWT_SECRET=

# Comma-separated list of allowed frontend origins (recommended in production)
# Example: CORS_ORIGINS=https://your-frontend.vercel.app,https://www.yourdomain.com
CORS_ORIGINS=

# Optional: GitHub repos feature
GITHUB_CLIENT_ID=
GITHUB_SECRET=

